rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.resource.data.code is string && request.resource.data.code.size() <= 16;
      allow update: if true;
      allow delete: if false;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
  }
}
